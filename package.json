{
  "name": "forja-launcher",
  "productName": "Forja Launcher",
  "version": "0.3.4",
  "description": "Кроссплатформенный лаунчер Minecraft: Java Edition (загрузчики модов, Modrinth, модпаки, автообновление)",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Forja Launcher contributors",
  "homepage": "https://github.com/zhekanisher7-rgb/Forja-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhekanisher7-rgb/Forja-launcher.git"
  },
  "forja": {
    "updates": {
      "owner": "zhekanisher7-rgb",
      "repo": "Forja-launcher"
    }
  },
  "scripts": {
    "start": "electron .",
    "pretest": "node scripts/check-deps.js",
    "test": "node --test test/unit/",
    "test:integration": "node --test --test-timeout=3600000 test/integration/",
    "launch:headless": "node scripts/headless-launch.js",
    "smoke": "node scripts/ci-smoke.js",
    "dist": "electron-builder --config electron-builder.config.js --publish never",
    "dist:win": "electron-builder --config electron-builder.config.js --win --publish never",
    "dist:mac": "electron-builder --config electron-builder.config.js --mac --publish never",
    "dist:linux": "electron-builder --config electron-builder.config.js --linux --publish never",
    "release": "electron-builder --config electron-builder.config.js --publish always"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "~6.2.1",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
